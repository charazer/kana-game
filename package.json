{
    "name": "kana-game",
    "version": "0.1.0",
    "private": false,
    "type": "module",
    "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
    "engines": {
        "node": ">=25.0.0"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "pnpm run test:unit:coverage && pnpm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:ui": "vitest --ui",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/svelte": "5.4.2",
        "@types/node": "25.9.9",
        "@typescript-eslint/eslint-plugin": "8.71.2",
        "@typescript-eslint/parser": "8.71.2",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "happy-dom": "20.14.0",
        "svelte": "5.57.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
