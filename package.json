{
    "name": "kana-game",
    "version": "0.1.0",
    "private": false,
    "type": "module",
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
    "engines": {
        "node": ">=25.0.0"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "pnpm run test:unit:coverage && pnpm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:ui": "vitest --ui",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/svelte": "5.4.2",
        "@types/node": "25.9.9",
        "@typescript-eslint/eslint-plugin": "8.72.1",
        "@typescript-eslint/parser": "8.72.1",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "happy-dom": "20.14.0",
        "svelte": "5.57.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.6",
        "vitest": "5.0.5"
    }
}
