{
    "name": "kana-game",
    "version": "0.1.0",
    "private": false,
    "type": "module",
    "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6",
    "engines": {
        "node": ">=25.0.0"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "pnpm run test:unit:coverage && pnpm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:ui": "vitest --ui",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/svelte": "5.4.2",
        "@types/node": "25.9.8",
        "@typescript-eslint/eslint-plugin": "8.70.1",
        "@typescript-eslint/parser": "8.70.1",
        "@vitest/coverage-v8": "5.0.1",
        "@vitest/ui": "5.0.1",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "happy-dom": "20.14.0",
        "svelte": "5.57.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vite": "8.3.1",
        "vitest": "5.0.1"
    }
}
