{
    "name": "kana-game",
    "version": "0.1.0",
    "private": false,
    "type": "module",
    "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
    "engines": {
        "node": ">=25.0.0"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "pnpm run test:unit:coverage && pnpm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:ui": "vitest --ui",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/svelte": "5.4.2",
        "@types/node": "25.9.9",
        "@typescript-eslint/eslint-plugin": "8.72.0",
        "@typescript-eslint/parser": "8.72.0",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "happy-dom": "20.14.0",
        "svelte": "5.57.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
