{
    "name": "kana-game",
    "version": "0.1.0",
    "private": false,
    "type": "module",
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
    "engines": {
        "node": ">=25.0.0"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "pnpm run test:unit:coverage && pnpm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:ui": "vitest --ui",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/svelte": "5.4.2",
        "@types/node": "25.9.7",
        "@typescript-eslint/eslint-plugin": "8.70.0",
        "@typescript-eslint/parser": "8.70.0",
        "@vitest/coverage-v8": "5.0.0",
        "@vitest/ui": "5.0.0",
        "eslint": "10.10.0",
        "eslint-config-prettier": "10.1.8",
        "happy-dom": "20.14.0",
        "svelte": "5.57.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.3.0",
        "vitest": "5.0.0"
    }
}
